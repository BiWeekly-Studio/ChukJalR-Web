{
  "name": "chukjalal-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "node --test tests/*.test.mjs",
    "build:toss": "VITE_AUTH_MODE=toss npm run build && ait build",
    "build:toss:ads:test": "node scripts/build-toss-ads.mjs test",
    "build:toss:ads:live": "node scripts/build-toss-ads.mjs live",
    "build:web": "VITE_AUTH_MODE=standalone npm run build",
    "build:toss:iap": "node scripts/build-toss-iap.mjs",
    "design:tokens": "node scripts/build-design-tokens.mjs",
    "design:brand": "node scripts/build-brand.mjs"
  },
  "dependencies": {
    "@apps-in-toss/web-framework": "^3.2.0",
    "@supabase/supabase-js": "^2.112.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
