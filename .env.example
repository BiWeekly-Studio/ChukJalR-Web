# 비워두면 목업 데이터로 동작한다. 채우면 Supabase 를 바라본다.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# 로그인 방식. 비우면 toss (앱인토스 미니앱 — 토스 로그인 브리지만 사용).
# standalone 으로 두면 소셜·이메일 로그인 화면이 정식 경로가 된다.
# 앱인토스는 미니앱 안의 계정 생성·소셜 로그인을 허용하지 않으므로,
# 미니앱 빌드에서는 반드시 비워둔다.
VITE_AUTH_MODE=

# Edge Function 전용 (클라이언트 번들에 절대 들어가면 안 된다)
# supabase secrets set API_FOOTBALL_KEY=...
#
# 토스 로그인 (toss-login 함수). 토스 콘솔에서 발급받는다.
# supabase secrets set TOSS_CLIENT_CERT="$(cat client.crt)"
# supabase secrets set TOSS_CLIENT_KEY="$(cat client.key)"
# supabase secrets set TOSS_AUTH_PEPPER=<서버 전용 임의 문자열, 바꾸면 기존 세션이 끊긴다>
